<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayout2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_rounded_background"
    android:orientation="vertical">

    <!-- ═══════════ 显示设置 ═══════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="@dimen/space_5"
        android:layout_marginBottom="@dimen/space_2"
        android:text="显示设置"
        android:textColor="?attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginEnd="@dimen/space_6"
        android:layout_marginBottom="@dimen/space_2"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/timetable_start_time"
            android:textColor="?attr/textColorPrimary" />

        <TextView
            android:id="@+id/from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/element_rounded_button_bg_primary_light"
            android:clickable="true"
            android:fontFamily="sans-serif-black"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_1"
            android:text="8:30"
            android:textColor="?attr/colorAccent" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_6"
        android:layout_marginBottom="@dimen/space_2"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/draw_bg_dashed_lines"
            android:textColor="?attr/textColorPrimary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/drawbglines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:thumbTint="?attr/colorPrimary"
            app:trackTint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- ═══════════ 个性化与外观 ═══════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="@dimen/space_5"
        android:layout_marginBottom="@dimen/space_2"
        android:text="个性化与外观"
        android:textColor="?attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_6"
        android:layout_marginBottom="@dimen/space_2"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/curriculum_manager_enable_color"
            android:textColor="?attr/textColorPrimary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/color_enable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:thumbTint="?attr/colorPrimary"
            app:trackTint="?attr/colorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_6"
        android:layout_marginBottom="@dimen/space_2"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/fade_enabled"
            android:textColor="?attr/textColorPrimary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/fade_enable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:thumbTint="?attr/colorPrimary"
            app:trackTint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- 随机分配颜色 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_6"
        android:layout_marginBottom="@dimen/space_2"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:text="科目颜色"
            android:textColor="?attr/textColorPrimary" />

        <androidx.cardview.widget.CardView
            android:id="@+id/reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_2"
                android:paddingTop="@dimen/space_1"
                android:paddingEnd="@dimen/space_3"
                android:paddingBottom="@dimen/space_1">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="@dimen/space_1"
                    app:srcCompat="@drawable/ic_baseline_color_lens_24"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/curriculum_manager_randomly_allocate_color"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_6"
        android:layout_marginBottom="@dimen/space_2"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/timetable_label_mode_period"
            android:textColor="?attr/textColorPrimary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/period_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:thumbTint="?attr/colorPrimary"
            app:trackTint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- ═══════════ 数据管理 ═══════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="@dimen/space_5"
        android:layout_marginBottom="@dimen/space_2"
        android:text="数据管理"
        android:textColor="?attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_6"
        android:layout_marginBottom="@dimen/space_4"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/timetable_auto_reimport"
            android:textColor="?attr/textColorPrimary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/auto_reimport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:thumbTint="?attr/colorPrimary"
            app:trackTint="?attr/colorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_6"
        android:layout_marginBottom="@dimen/space_4"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallpaper_scrim_opacity"
            android:textColor="?attr/textColorPrimary"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/scrim_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:max="80"
            android:progress="30"
            android:progressTint="?attr/colorPrimary"
            android:thumbTint="?attr/colorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_6"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_6"
        android:layout_marginBottom="@dimen/space_4"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/card_opacity"
            android:textColor="?attr/textColorPrimary"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/card_opacity_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:max="100"
            android:progress="85"
            android:progressTint="?attr/colorPrimary"
            android:thumbTint="?attr/colorPrimary" />
    </LinearLayout>

</LinearLayout>
